[Unit]
Description=Backuppo backup agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=backuppo
Group=backuppo
EnvironmentFile=-/etc/backuppo/backuppo.env
Environment=RUST_LOG=info
ExecStart=/usr/bin/bkpo daemon --config /etc/backuppo/config.yaml
Restart=on-failure
RestartSec=10s
TimeoutStopSec=120s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
StateDirectory=backuppo

[Install]
WantedBy=multi-user.target
