[Unit]
Description=Backuppo hub multi-sito
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=backuppo-hub
Group=backuppo-hub
EnvironmentFile=-/etc/backuppo-hub/backuppo-hub.env
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/backuppo-hub serve --config /etc/backuppo-hub/config.yaml
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
StateDirectory=backuppo-hub

[Install]
WantedBy=multi-user.target
