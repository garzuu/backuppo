{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backuppo",
  "version": "0.1.0",
  "identifier": "com.garzu.backuppo",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/backuppo-squirrel-v3.png", "icons/icon.ico"]
  }
}
